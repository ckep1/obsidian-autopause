{
	"name": "obsidian-auto-pause",
	"version": "1.2.0",
	"description": "This is a plugin for Obsidian (https://obsidian.md) that automatically pauses all audio elements when a new audio element is played.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"autopause"
	],
	"author": "Chris Kephart",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^16.11.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "4.9.5",
		"typescript-eslint": "^8.70.0"
	},
	"overrides": {
		"file-entry-cache": "11.1.5",
		"flat-cache": "6.1.23",
		"keyv": "5.6.0",
		"cacheable": "2.5.0",
		"@cacheable/memory": "2.2.0",
		"@cacheable/utils": "2.5.0",
		"@keyv/bigmap": "1.3.1",
		"@keyv/serialize": "1.1.1"
	}
}
